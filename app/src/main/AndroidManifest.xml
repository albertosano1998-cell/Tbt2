<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <application android:theme="@android:style/Theme.Material.Light.NoActionBar" android:label="Game Recorder" android:allowBackup="false">
        <activity android:name=".VideoLibraryActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <service android:name=".ScreenRecordService" android:exported="false" android:foregroundServiceType="mediaProjection|microphone" />
        <service android:name=".OverlayControlService" android:exported="false" />
    </application>
</manifest>